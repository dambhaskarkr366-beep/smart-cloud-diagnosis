/* ============================================
   app.wxss —— 全局样式
   校园二手交易小程序
   ============================================ */

/* ---------- CSS 变量（设计令牌） ---------- */
page {
  /* 主色调：紫色系 */
  --primary: #6C63FF;
  --primary-light: #8B85FF;
  --primary-dark: #4A42DB;
  --primary-bg: #F0EFFF;

  /* 强调色：青绿色 */
  --accent: #3EC6A8;
  --accent-light: #5FDBC5;
  --accent-dark: #2DA88D;
  --accent-bg: #E6FAF5;

  /* 危险色：红色 */
  --danger: #FF4D4D;
  --danger-light: #FF7A7A;
  --danger-bg: #FFEEEE;

  /* 中性色 */
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-hint: #999999;
  --text-disabled: #CCCCCC;

  /* 背景色 */
  --bg-page: #F5F5F5;
  --bg-white: #FFFFFF;
  --bg-card: #FFFFFF;
  --bg-divider: #EEEEEE;

  /* 边框 */
  --border-color: #E5E5E5;
  --border-radius-sm: 4rpx;
  --border-radius-md: 6rpx;
  --border-radius-lg: 8rpx;

  /* 阴影 */
  --shadow-card: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  --shadow-float: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);

  /* 字号 */
  --font-xs: 22rpx;
  --font-sm: 26rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 44rpx;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* 基础设置 */
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial,
    sans-serif;
  font-size: var(--font-md);
  color: var(--text-primary);
  background-color: var(--bg-page);
  box-sizing: border-box;
  line-height: 1.6;
}

/* ---------- 全局重置 ---------- */
view,
text,
image,
swiper,
swiper-item,
scroll-view,
input,
textarea,
button,
navigator {
  box-sizing: border-box;
}

/* 移除 button 默认样式 */
button {
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  border-radius: 0;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}

button::after {
  border: none;
}

/* 移除 input 默认样式 */
input {
  outline: none;
  border: none;
  background: none;
}

/* 移除 textarea 默认样式 */
textarea {
  outline: none;
  border: none;
  background: none;
}

/* 图片默认样式 */
image {
  display: block;
  vertical-align: middle;
}

/* ---------- 通用工具类 ---------- */

/* 弹性布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

.flex-wrap {
  flex-wrap: wrap;
}

/* 文字对齐 */
.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

/* 文字颜色 */
.text-primary {
  color: var(--primary);
}

.text-accent {
  color: var(--accent);
}

.text-danger {
  color: var(--danger);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-hint {
  color: var(--text-hint);
}

/* 文字大小 */
.text-xs {
  font-size: var(--font-xs);
}

.text-sm {
  font-size: var(--font-sm);
}

.text-md {
  font-size: var(--font-md);
}

.text-lg {
  font-size: var(--font-lg);
}

.text-xl {
  font-size: var(--font-xl);
}

.text-xxl {
  font-size: var(--font-xxl);
}

/* 文字粗细 */
.font-bold {
  font-weight: bold;
}

/* 文字溢出省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 间距 */
.mt-xs {
  margin-top: var(--spacing-xs);
}

.mt-sm {
  margin-top: var(--spacing-sm);
}

.mt-md {
  margin-top: var(--spacing-md);
}

.mt-lg {
  margin-top: var(--spacing-lg);
}

.mb-sm {
  margin-bottom: var(--spacing-sm);
}

.mb-md {
  margin-bottom: var(--spacing-md);
}

.ml-sm {
  margin-left: var(--spacing-sm);
}

.mr-sm {
  margin-right: var(--spacing-sm);
}

.p-sm {
  padding: var(--spacing-sm);
}

.p-md {
  padding: var(--spacing-md);
}

/* 背景 */
.bg-white {
  background-color: var(--bg-white);
}

.bg-page {
  background-color: var(--bg-page);
}

/* 圆角 */
.rounded-sm {
  border-radius: var(--border-radius-sm);
}

.rounded-md {
  border-radius: var(--border-radius-md);
}

.rounded-lg {
  border-radius: var(--border-radius-lg);
}

/* 阴影 */
.shadow-card {
  box-shadow: var(--shadow-card);
}

/* 单行列表项（常见模式） */
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md);
  background-color: var(--bg-white);
  border-bottom: 1rpx solid var(--bg-divider);
}

.list-item:last-child {
  border-bottom: none;
}

/* ---------- 空状态 ---------- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) 0;
  color: var(--text-hint);
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.5;
}

/* ---------- 加载状态 ---------- */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg) 0;
}

.loading-text {
  font-size: var(--font-sm);
  color: var(--text-hint);
  margin-left: var(--spacing-sm);
}

/* 底部加载更多提示 */
.load-more-tip {
  text-align: center;
  padding: var(--spacing-md) 0;
  font-size: var(--font-sm);
  color: var(--text-hint);
}

/* ---------- 安全区域适配 ---------- */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ---------- 按钮 ---------- */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background-color: var(--primary);
  color: #ffffff;
  border-radius: var(--border-radius-md);
  font-size: var(--font-lg);
  font-weight: 500;
}

.btn-primary:active {
  background-color: var(--primary-dark);
}

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background-color: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: var(--border-radius-md);
  font-size: var(--font-lg);
}

.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background-color: var(--danger);
  color: #ffffff;
  border-radius: var(--border-radius-md);
  font-size: var(--font-lg);
}

/* 小按钮 */
.btn-sm {
  height: 56rpx;
  padding: 0 var(--spacing-md);
  font-size: var(--font-sm);
  border-radius: var(--border-radius-sm);
}

/* ---------- 价格样式 ---------- */
.price {
  color: var(--danger);
  font-weight: bold;
}

.price::before {
  content: "¥";
  font-size: 0.75em;
}
