/* pages/detail/detail.wxss —— 商品详情页样式 */
.page-container {
  min-height: 100vh;
  background-color: var(--bg-page);
}

/* ===== 加载/错误状态（复用通用样式） ===== */
.loading-container,
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--bg-divider);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: var(--font-sm);
  color: var(--text-hint);
}

.error-icon {
  font-size: 80rpx;
}

/* ===== 图片轮播 ===== */
.swiper-wrap {
  position: relative;
  width: 100%;
  height: 750rpx;
  background-color: #1a1a1a;
}

.detail-swiper {
  width: 100%;
  height: 100%;
}

.swiper-img {
  width: 100%;
  height: 100%;
}

/* 图片计数器（右上角） */
.swiper-counter {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  color: #ffffff;
  background-color: rgba(0, 0, 0, 0.45);
  border-radius: 4rpx;
  backdrop-filter: blur(6rpx);
}

/* 返回按钮 */
.back-btn {
  position: absolute;
  top: 16rpx;
  left: 20rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.35);
  border-radius: 4rpx;
  backdrop-filter: blur(6rpx);
}

.back-icon {
  font-size: 44rpx;
  color: #ffffff;
  line-height: 1;
  margin-top: -2rpx;
}

/* ===== 价格 + 标题 ===== */
.info-card {
  margin: 24rpx;
  padding: 28rpx;
  background-color: var(--bg-white);
  border-radius: var(--border-radius-md);
  box-shadow: var(--shadow-card);
}

.price-row {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: var(--font-lg);
  color: var(--danger);
  font-weight: 700;
}

.price-value {
  font-size: 48rpx;
  color: var(--danger);
  font-weight: 700;
  line-height: 1;
}

.original-price {
  margin-left: 12rpx;
  font-size: var(--font-sm);
  color: var(--text-hint);
  text-decoration: line-through;
}

.title-row {
  margin-top: 16rpx;
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
  word-break: break-all;
}

/* 标签行 */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  border-radius: 8rpx;
  line-height: 1.4;
}

.tag-condition {
  color: var(--accent);
  background-color: var(--accent-bg);
}

.tag-method {
  color: var(--primary);
  background-color: var(--primary-bg);
}

.tag-category {
  color: #FF9500;
  background-color: #FFF3E0;
}

/* 统计行 */
.stats-row {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--bg-divider);
}

.stat-item {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* ===== 卖家卡片 ===== */
.seller-card {
  display: flex;
  align-items: center;
  margin: 0 24rpx 16rpx;
  padding: 24rpx 28rpx;
  background-color: var(--bg-white);
  border-radius: var(--border-radius-md);
  box-shadow: var(--shadow-card);
}

.seller-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 4rpx;
  background-color: var(--bg-divider);
  flex-shrink: 0;
}

.seller-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.seller-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
}

.seller-school {
  margin-top: 4rpx;
}

.seller-arrow {
  font-size: 36rpx;
  flex-shrink: 0;
}

/* ===== 交易地点 ===== */
.location-card {
  margin: 0 24rpx 16rpx;
  padding: 24rpx 28rpx;
  background-color: var(--bg-white);
  border-radius: var(--border-radius-md);
  box-shadow: var(--shadow-card);
}

.location-label {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.location-value {
  font-size: var(--font-md);
  color: var(--text-secondary);
}

/* ===== 商品描述 ===== */
.desc-card {
  margin: 0 24rpx 16rpx;
  padding: 24rpx 28rpx;
  background-color: var(--bg-white);
  border-radius: var(--border-radius-md);
  box-shadow: var(--shadow-card);
}

.desc-title {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.desc-content {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

/* ===== 底部占位 ===== */
.bottom-placeholder {
  height: 140rpx;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  height: 112rpx;
  padding: 0 24rpx;
  background-color: var(--bg-white);
  border-top: 1rpx solid var(--bg-divider);
  z-index: 100;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.bottom-fav {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 80rpx;
  border-radius: var(--border-radius-sm);
  transition: all 0.2s;
}

.bottom-fav.faved {
  color: var(--danger);
}

.fav-icon {
  font-size: 36rpx;
  line-height: 1;
}

.fav-text {
  font-size: 20rpx;
  margin-top: 2rpx;
  color: var(--text-secondary);
}

.bottom-contact {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  margin-left: 20rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: var(--font-md);
  font-weight: 500;
  border-radius: 4rpx;
  letter-spacing: 2rpx;
}

.bottom-contact:active {
  opacity: 0.9;
}
