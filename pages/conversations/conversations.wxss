/* pages/conversations/conversations.wxss */
.page-container { min-height: 100vh; background: var(--bg-page); }
.loading-box, .center-box { display: flex; flex-direction: column; align-items: center; justify-content: center; padding-top: 200rpx; }
.spinner { width: 48rpx; height: 48rpx; border: 3rpx solid var(--bg-divider); border-top-color: var(--primary); border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.conv-list { padding: 16rpx 0; }
.conv-item {
  display: flex; align-items: center;
  padding: 24rpx; margin: 0 24rpx 2rpx;
  background: var(--bg-white);
}
.conv-item:first-child { border-radius: 6rpx 6rpx 0 0; }
.conv-item:last-child { border-radius: 0 0 6rpx 6rpx; margin-bottom: 0; }

.conv-avatar { width: 88rpx; height: 88rpx; border-radius: 4rpx; background: var(--bg-divider); flex-shrink: 0; }
.conv-body { flex: 1; margin: 0 20rpx; overflow: hidden; }
.conv-top { display: flex; justify-content: space-between; align-items: center; }
.conv-name { font-size: var(--font-md); font-weight: 500; }
.conv-time { flex-shrink: 0; margin-left: 12rpx; }
.conv-bottom { display: flex; align-items: center; margin-top: 8rpx; }
.conv-preview { flex: 1; }
.conv-badge { min-width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center; font-size: 20rpx; color: #fff; background: var(--danger); border-radius: 18rpx; padding: 0 8rpx; margin-left: 12rpx; flex-shrink: 0; }
.conv-thumb { width: 80rpx; height: 80rpx; border-radius: 4rpx; background: var(--bg-divider); flex-shrink: 0; }
