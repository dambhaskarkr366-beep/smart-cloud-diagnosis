/* pages/my-favorites/my-favorites.wxss */
.page-container {
  min-height: 100vh;
  background-color: var(--bg-page);
}

.loading-container, .error-container, .empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}
.loading-spinner {
  width: 56rpx; height: 56rpx;
  border: 4rpx solid var(--bg-divider);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { margin-top: 20rpx; font-size: var(--font-sm); color: var(--text-hint); }
.empty-icon { font-size: 80rpx; }

/* 瀑布流 */
.waterfall { display: flex; padding: 16rpx; gap: 16rpx; align-items: flex-start; }
.waterfall-column { flex: 1; display: flex; flex-direction: column; gap: 16rpx; }
.load-more-tip { text-align: center; padding: 32rpx 0; font-size: var(--font-sm); }
