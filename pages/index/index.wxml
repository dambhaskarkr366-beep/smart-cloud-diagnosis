<!-- pages/index/index.wxml —— 首页（双列瀑布流） -->
<view class="page-container">
  <!-- ===== 搜索栏 ===== -->
  <view class="search-bar" bindtap="onSearchTap">
    <view class="search-input-wrapper">
      <text class="search-icon">搜索</text>
      <input
        class="search-input"
        placeholder="搜索你想要的宝贝…"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
        catchtap="noop"
      />
    </view>
  </view>

  <!-- ===== 分类Tab（横向滚动） ===== -->
  <scroll-view class="tab-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tab-inner">
      <view
        wx:for="{{tabs}}"
        wx:key="*this"
        class="tab-item {{activeTab === item ? 'tab-active' : ''}}"
        data-tab="{{item}}"
        bindtap="onTabChange"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <!-- ===== 首次加载中 ===== -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在发现好物…</text>
  </view>

  <!-- ===== 加载失败 ===== -->
  <view wx:elif="{{error}}" class="error-container">
    <view class="error-icon">×</view>
    <text class="text-md text-secondary mt-sm">{{errorMsg}}</text>
    <view class="btn-primary btn-sm mt-md" bindtap="onRetry">重新加载</view>
  </view>

  <!-- ===== 瀑布流商品列表 ===== -->
  <view wx:else class="waterfall">
    <!-- 左列 -->
    <view class="waterfall-column">
      <view
        wx:for="{{leftList}}"
        wx:key="_id"
        class="waterfall-item"
      >
        <item-card item="{{item}}" compact="{{true}}" />
      </view>
    </view>

    <!-- 右列 -->
    <view class="waterfall-column">
      <view
        wx:for="{{rightList}}"
        wx:key="_id"
        class="waterfall-item"
      >
        <item-card item="{{item}}" compact="{{true}}" />
      </view>
    </view>
  </view>

  <!-- ===== 空状态 ===== -->
  <view wx:if="{{!loading && !error && leftList.length === 0 && rightList.length === 0}}" class="empty-state">
    <view class="empty-icon"></view>
    <text class="text-md text-hint mt-sm">暂无商品</text>
    <text class="text-xs text-hint mt-xs">快去发布第一个宝贝吧～</text>
  </view>

  <!-- ===== 加载更多中 ===== -->
  <view wx:if="{{loadingMore}}" class="load-more-tip">
    <text>加载中…</text>
  </view>

  <!-- ===== 没有更多了 ===== -->
  <view wx:if="{{!hasMore && (leftList.length > 0 || rightList.length > 0) && !loadingMore}}" class="load-more-tip">
    <text class="text-hint">—— 已经到底啦 ——</text>
  </view>
</view>
