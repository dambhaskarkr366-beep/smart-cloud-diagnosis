/* pages/index/index.wxss —— 首页样式 */
.page-container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding-bottom: 40rpx;
}

/* ===== 搜索栏 ===== */
.search-bar {
  padding: 16rpx 24rpx;
  background-color: var(--bg-white);
  position: sticky;
  top: 0;
  z-index: 90;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  height: 72rpx;
  background-color: var(--bg-page);
  border-radius: 4rpx;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: var(--font-md);
}

/* ===== 分类Tab ===== */
.tab-scroll {
  background-color: var(--bg-white);
  border-bottom: 1rpx solid var(--bg-divider);
  position: sticky;
  top: 104rpx; /* 搜索栏高度 */
  z-index: 89;
}

.tab-inner {
  display: flex;
  padding: 16rpx 24rpx;
  white-space: nowrap;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  border-radius: 4rpx;
  background-color: var(--bg-page);
  transition: all 0.2s;
  flex-shrink: 0;
}

.tab-active {
  color: #ffffff;
  background-color: var(--primary);
  font-weight: 500;
}

/* ===== 瀑布流 ===== */
.waterfall {
  display: flex;
  padding: 16rpx 16rpx 0;
  gap: 16rpx;
  align-items: flex-start;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.waterfall-item {
  /* 卡片之间的间距由 column 的 gap 控制 */
}

/* ===== 加载中（首次） ===== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--bg-divider);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: var(--font-sm);
  color: var(--text-hint);
}

/* ===== 加载失败 ===== */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.error-icon {
  font-size: 80rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.6;
}

/* ===== 加载更多 ===== */
.load-more-tip {
  text-align: center;
  padding: 32rpx 0 48rpx;
  font-size: var(--font-sm);
  color: var(--text-hint);
}
