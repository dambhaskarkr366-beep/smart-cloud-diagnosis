/* pages/guide/guide.wxss —— 新用户引导页样式 */
.page-container {
  min-height: 100vh;
  background-color: var(--bg-white);
  display: flex;
  flex-direction: column;
}

/* 欢迎页 */
.welcome-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: var(--spacing-xl);
}

.welcome-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.welcome-icon {
  font-size: 120rpx;
}

.welcome-footer {
  width: 100%;
  padding: var(--spacing-md);
  position: fixed;
  bottom: 0;
  left: 0;
}

/* 表单页 */
.form-section {
  flex: 1;
  padding: var(--spacing-xl) var(--spacing-md);
}

.form-header {
  margin-bottom: var(--spacing-lg);
}

/* ---------- 头像 + 昵称卡片 ---------- */
.profile-card {
  box-shadow: var(--shadow-card);
}

/* 头像选择按钮（重置 button 默认样式） */
.avatar-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  line-height: 1;
}

.avatar-picker::after {
  border: none;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 4rpx;
  background-color: var(--bg-divider);
  border: 2rpx solid var(--primary-light);
}

.avatar-tip {
  color: var(--text-hint);
}

/* 昵称输入区 */
.nickname-input {
  display: flex;
  align-items: center;
}

.input-lg {
  width: 100%;
  height: 80rpx;
  font-size: var(--font-lg);
  color: var(--text-primary);
  padding: 0 16rpx;
  background: var(--bg-page);
  border-radius: 4rpx;
}

.input-lg:focus {
  background: #fff;
}

/* ---------- 学校信息表单 ---------- */
.form-card {
  box-shadow: var(--shadow-card);
}

.form-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--bg-divider);
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 120rpx;
  font-size: var(--font-md);
  font-weight: 500;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: var(--font-md);
  text-align: right;
}

/* ---------- 提交按钮 ---------- */
.form-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--bg-white);
}
