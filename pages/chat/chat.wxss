/* pages/chat/chat.wxss —— 聊天页样式 */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #EDEDED;
}

/* ===== 加载 ===== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--bg-divider);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: var(--font-sm);
  color: var(--text-hint);
}

/* ===== 关联商品信息条 ===== */
.item-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: var(--bg-white);
  border-bottom: 1rpx solid #E0E0E0;
}

.item-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background-color: var(--bg-divider);
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}

.item-status {
  padding: 4rpx 16rpx;
  background-color: var(--primary-bg);
  color: var(--primary);
  border-radius: 8rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ===== 消息列表 ===== */
.message-list {
  flex: 1;
  padding: 20rpx 24rpx;
  overflow-y: auto;
}

.empty-msg {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
}

/* 消息行 */
.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.msg-other {
  /* 对方消息靠左（默认 flex-start） */
}

.msg-mine {
  flex-direction: row-reverse;
}

/* 头像 */
.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 4rpx;
  background-color: #E0E0E0;
  flex-shrink: 0;
}

/* 气泡 */
.msg-bubble {
  max-width: 65%;
  padding: 18rpx 24rpx;
  font-size: var(--font-md);
  line-height: 1.6;
  word-break: break-all;
  border-radius: 16rpx;
  position: relative;
}

.bubble-other {
  margin-left: 16rpx;
  background-color: #ffffff;
  color: var(--text-primary);
  border-top-left-radius: 4rpx;
}

.bubble-mine {
  margin-right: 16rpx;
  background-color: #95EC69;
  color: var(--text-primary);
  border-top-right-radius: 4rpx;
}

.bubble-sending {
  opacity: 0.7;
}

.bubble-failed {
  background-color: #FFE0E0;
  border: 2rpx solid var(--danger-light);
}

/* 图片消息气泡（透明背景，无padding） */
.bubble-image {
  background-color: transparent !important;
  padding: 0 !important;
  overflow: hidden;
  border-radius: 12rpx;
}
.msg-image {
  display: block;
  width: 320rpx;
  height: 320rpx;
  border-radius: 12rpx;
  background-color: var(--bg-divider);
}

/* 发送状态标记 */
.msg-failed {
  display: flex;
  align-items: center;
  margin-right: 8rpx;
  padding: 4rpx 8rpx;
}

.msg-sending {
  display: flex;
  align-items: center;
  margin-right: 8rpx;
}

/* ===== 输入栏 ===== */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #F7F7F7;
  border-top: 1rpx solid #E0E0E0;
  gap: 12rpx;
}

/* 图片按钮 */
.img-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.img-btn-icon { font-size: 36rpx; line-height: 1; }

.msg-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background-color: #ffffff;
  border-radius: 8rpx;
  font-size: var(--font-md);
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #E0E0E0;
  color: #999;
  font-size: var(--font-md);
  border-radius: 8rpx;
  flex-shrink: 0;
  transition: all 0.2s;
}

.send-active {
  background-color: var(--primary);
  color: #ffffff;
}
