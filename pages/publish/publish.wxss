/* pages/publish/publish.wxss —— 发布商品页样式 */
.page-container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding-bottom: 80rpx;
}

/* ===== 区块卡片 ===== */
.section-card {
  margin: 20rpx 24rpx;
  padding: 28rpx;
  background-color: var(--bg-white);
  border-radius: var(--border-radius-md);
  box-shadow: var(--shadow-card);
}

.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

/* ===== 图片上传 ===== */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--border-radius-sm);
  overflow: hidden;
  background-color: var(--bg-divider);
}

.image-item .img {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 0 0 0 12rpx;
  z-index: 2;
}

.add-btn {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: var(--bg-page);
  border: 2rpx dashed var(--border-color);
  border-radius: var(--border-radius-sm);
}

.add-icon {
  font-size: 64rpx;
  color: var(--text-hint);
  line-height: 1;
}

.add-text {
  margin-top: 4rpx;
}

.uploading-tip {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--primary-bg);
  border-radius: var(--border-radius-sm);
}

/* ===== 表单项 ===== */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--bg-divider);
}

.form-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.form-item:first-child {
  padding-top: 0;
}

.label {
  width: 140rpx;
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--text-primary);
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: var(--font-md);
  text-align: right;
  color: var(--text-primary);
}

.input-row {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.currency {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--danger);
  margin-right: 6rpx;
}

.input-price {
  text-align: left;
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--danger);
  width: 160rpx;
}

/* 原价样式（灰色弱化） */
.currency-original {
  color: var(--text-hint);
  font-weight: 400;
}
.input-original {
  color: var(--text-hint);
  font-weight: 400;
  font-size: var(--font-md);
}

/* 地点输入框 + 地图选点按钮 */
.input-location {
  text-align: right;
  flex: 1;
  margin-right: 16rpx;
}
.location-pick-btn {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  background-color: var(--primary-bg);
  border-radius: 8rpx;
}

/* ===== Picker 选择器 ===== */
.picker-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: var(--font-md);
  color: var(--text-primary);
}

.picker-value.placeholder {
  color: var(--text-hint);
}

.picker-arrow {
  font-size: 32rpx;
  color: var(--text-hint);
  margin-left: 8rpx;
}

/* ===== 描述输入 ===== */
.desc-input {
  width: 100%;
  min-height: 180rpx;
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: 1.8;
  padding: 16rpx;
  background-color: var(--bg-page);
  border-radius: var(--border-radius-sm);
}

.desc-count {
  text-align: right;
  margin-top: 10rpx;
}

/* ===== 提交按钮 ===== */
.submit-section {
  margin: 32rpx 24rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary);
  color: #ffffff;
  font-size: var(--font-lg);
  font-weight: 600;
  border-radius: 4rpx;
  border: none;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(108, 99, 255, 0.3);
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-disabled {
  background: var(--bg-divider);
  color: var(--text-hint);
  box-shadow: none;
}
