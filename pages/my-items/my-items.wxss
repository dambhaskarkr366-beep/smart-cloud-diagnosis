/* pages/my-items/my-items.wxss */
.page-container {
  min-height: 100vh;
  background-color: var(--bg-page);
}

/* 加载/空/错误 */
.loading-container, .error-container, .empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}
.loading-spinner {
  width: 56rpx; height: 56rpx;
  border: 4rpx solid var(--bg-divider);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { margin-top: 20rpx; font-size: var(--font-sm); color: var(--text-hint); }
.empty-icon { font-size: 80rpx; opacity: 0.6; }

/* 列表 */
.list-container { padding: 16rpx 0; }
.list-item-card {
  display: flex;
  margin: 0 24rpx 16rpx;
  padding: 20rpx;
  background: var(--bg-white);
  border-radius: var(--border-radius-md);
  box-shadow: var(--shadow-card);
}
.list-img {
  width: 160rpx; height: 160rpx;
  border-radius: var(--border-radius-sm);
  background: var(--bg-divider);
  flex-shrink: 0;
}
.list-info { flex: 1; margin-left: 20rpx; overflow: hidden; display: flex; flex-direction: column; }
.list-title { font-size: var(--font-md); color: var(--text-primary); line-height: 1.4; }
.list-meta { display: flex; align-items: center; gap: 16rpx; }
.status-tag { padding: 2rpx 12rpx; border-radius: 6rpx; font-size: 20rpx; }
.tag-selling { background: var(--accent-bg); color: var(--accent); }
.tag-sold { background: var(--bg-divider); color: var(--text-hint); }
.load-more-tip { text-align: center; padding: 32rpx 0; font-size: var(--font-sm); }
