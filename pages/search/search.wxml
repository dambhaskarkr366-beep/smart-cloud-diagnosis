<!-- pages/search/search.wxml —— 搜索结果页（复用首页瀑布流） -->
<view class="page-container">
  <!-- ===== 搜索栏 ===== -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <text class="search-icon">搜索</text>
      <input
        class="search-input"
        placeholder="搜索你想要的宝贝…"
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
        focus="{{!keyword}}"
      />
    </view>
    <view wx:if="{{keyword}}" class="search-cancel" bindtap="onClearSearch">取消</view>
  </view>

  <!-- ===== 分类Tab ===== -->
  <scroll-view class="tab-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tab-inner">
      <view
        wx:for="{{tabs}}"
        wx:key="*this"
        class="tab-item {{activeTab === item ? 'tab-active' : ''}}"
        data-tab="{{item}}"
        bindtap="onTabChange"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <!-- ===== 搜索结果提示 ===== -->
  <view wx:if="{{keyword && !loading}}" class="result-header">
    <text class="text-sm text-secondary">
      搜索 "<text class="text-primary">{{keyword}}</text>" 共 <text class="text-primary">{{total}}</text> 个结果
    </text>
  </view>

  <!-- ===== 加载中 ===== -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">搜索中…</text>
  </view>

  <!-- ===== 加载失败 ===== -->
  <view wx:elif="{{error}}" class="error-container">
    <view class="error-icon">×</view>
    <text class="text-md text-secondary mt-sm">{{errorMsg}}</text>
    <view class="btn-primary btn-sm mt-md" bindtap="onRetry">重新搜索</view>
  </view>

  <!-- ===== 瀑布流商品列表 ===== -->
  <view wx:else class="waterfall">
    <view class="waterfall-column">
      <view wx:for="{{leftList}}" wx:key="_id" class="waterfall-item">
        <item-card item="{{item}}" />
      </view>
    </view>
    <view class="waterfall-column">
      <view wx:for="{{rightList}}" wx:key="_id" class="waterfall-item">
        <item-card item="{{item}}" />
      </view>
    </view>
  </view>

  <!-- ===== 空结果 ===== -->
  <view wx:if="{{!loading && !error && keyword && leftList.length === 0 && rightList.length === 0}}" class="empty-state">
    <view class="empty-icon"></view>
    <text class="text-md text-hint mt-sm">未找到相关商品</text>
    <text class="text-xs text-hint mt-xs">换个关键词试试吧</text>
  </view>

  <!-- ===== 输入关键词提示 ===== -->
  <view wx:if="{{!keyword && !loading}}" class="empty-state">
    <view class="empty-icon"></view>
    <text class="text-md text-hint mt-sm">输入关键词搜索</text>
  </view>

  <!-- ===== 加载更多 / 到底 ===== -->
  <view wx:if="{{loadingMore}}" class="load-more-tip">
    <text>加载中…</text>
  </view>
  <view wx:if="{{!hasMore && (leftList.length > 0 || rightList.length > 0) && !loadingMore}}" class="load-more-tip">
    <text class="text-hint">—— 已经到底啦 ——</text>
  </view>
</view>
